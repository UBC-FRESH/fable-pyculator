# Example nginx reverse proxy for the FABLE Pyculator portal.
#
# The portal should still bind to loopback. nginx terminates TLS and, if desired, adds its own
# authentication. The service can also use built-in HTTP Basic auth via portal.env.
#
# If you mount under a subpath, either:
#   - start the portal with FABLE_PORTAL_ROOT_PATH=/fable (recommended), or
#   - keep root_path empty and use an exact location that preserves the trailing slash.
#
# Replace example.org and the certificate paths before use.

server {
    listen 443 ssl http2;
    server_name example.org;

    ssl_certificate     /etc/letsencrypt/live/example.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/example.org/privkey.pem;

    client_max_body_size 20m;

    location /fable/ {
        proxy_pass http://127.0.0.1:8768/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Prefix /fable;
        proxy_read_timeout 620s;
        proxy_buffering off;
    }

    location = /fable {
        return 301 /fable/;
    }
}
