# Copy to /etc/fable-pyculator/portal.env and restrict to root/portal user (chmod 600).
# Never commit real credentials.

FABLE_PORTAL_ROOT=/opt/fable-pyculator
FABLE_PORTAL_PYTHON=/opt/fable-pyculator/.venv/bin/python
FABLE_PORTAL_RUNTIME=/var/lib/fable-pyculator/runtime
FABLE_PORTAL_HOST=127.0.0.1
FABLE_PORTAL_PORT=8768
FABLE_PORTAL_ROOT_PATH=
FABLE_PORTAL_ALLOW_REMOTE=0
FABLE_PORTAL_ALLOW_AGENT=0
FABLE_PORTAL_AUTH_USER=operator
FABLE_PORTAL_AUTH_PASSWORD=change-me
